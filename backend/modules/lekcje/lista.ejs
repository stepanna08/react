<div class="row">
	<div class="col-12">
		<h1>Lista lekcji</h1>
	</div>
</div>
<div class="row">
	<div class="col-12">
		<% if (lekcje.length) { %>
			<ul class="list-group">
				<% lekcje.forEach(lekcja => { %>
					<li class="list-group-item">
						<a href="/lekcje/details/<%= lekcja.id %>">
							<%= lekcja.nazwa %> <%= lekcja.dzien_tygodnia %> <%= lekcja.godzina_lekcyjna %> - <%= lekcja.nazwa_klasy %> <%= lekcja.nazwa_przedmiotu %>
						</a>
					</li>
				<% }) %>
			</ul>
		<% } else { %>
			<p>brak lekcji</p>
		<% } %>
		<p class="mt-3"><a class="btn btn-primary" href="/lekcje/add">Dodaj lekcję</a></p>
	</div>
</div>
