<div class="row">
	<div class="col-12">
		<h1>Lista nauczycieli</h1>
	</div>
</div>
<div class="row">
	<div class="col-12">
		<ul class="list-group">
			<% nauczyciele.forEach(nauczyciel => { %>
				<li class="list-group-item">
					<a href="/nauczyciele/details/<%= nauczyciel.id %>">
						<%= nauczyciel.imie %> <%= nauczyciel.nazwisko %>
					</a>
				</li>
			<% }) %>
		</ul>
		<p class="mt-3"><a class="btn btn-primary" href="/nauczyciele/add">Dodaj nauczyciela</a></p>
	</div>
</div>
