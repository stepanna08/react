<% if (dodajNauczyciela) { %>
	<div class="alert alert-success" role="alert"><%= dodajNauczyciela %></div>
<% } %>
<div class="row">
	<div class="col-12">
		<h1>Lista nauczycieli</h1>
	</div>
</div>
<div class="row">
	<div class="col-12">
		<% if (nauczyciele.length) { %>
			<ul class="list-group">
				<% nauczyciele.forEach(nauczyciel => { %>
					<li class="list-group-item d-flex justify-content-between align-items-center">
						<span><%= nauczyciel.imie %> <%= nauczyciel.nazwisko %></span>
						<i class="fas fa-trash text-danger" style="cursor: pointer;" onclick="if(confirm('Czy na pewno usunąć nauczyciela ze szkoły?')) { window.location='/nauczyciele/szkola/delete/<%= nauczyciel.id %>'; }"></i>
					</li>
				<% }) %>
			</ul>
		<% } else { %>
			<p>brak nauczycieli</p>
		<% } %>
		<p class="mt-3"><a class="btn btn-primary" href="/nauczyciele/szkola/add">Dodaj nauczyciela</a></p>
	</div>
</div>
