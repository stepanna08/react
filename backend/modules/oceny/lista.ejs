<div class="row">
	<div class="col-12">
		<h1>Lista ocen</h1>
	</div>
</div>
<div class="row">
	<div class="col-12">
		<ul class="list-group">
			<% oceny.forEach(ocena => { %>
				<li class="list-group-item d-flex justify-content-between align-items-center">
					<a href="/oceny/details/<%= ocena.id %>">
						<%= ocena.imie_ucznia %> <%= ocena.nazwisko_ucznia %> - <%= ocena.nazwa_przedmiotu %>: <strong><%= ocena.wartosc %></strong> (<%= ocena.data %>)
					</a>
					<a href="/oceny/delete/<%= ocena.id %>" class="btn btn-danger btn-sm"><i class="fas fa-trash"></i></a>
				</li>
			<% }) %>
		</ul>
		<p class="mt-3"><a class="btn btn-primary" href="/oceny/add">Dodaj ocenę</a></p>
	</div>
</div>
