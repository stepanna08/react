<div class="row">
	<div class="col-12">
		<h1>Szczegóły klasy: <%= klasa.nazwa %></h1>
	</div>
</div>
<div class="row">
	<div class="col-12">
		<dl class="row">
			<dt class="col-sm-3">id:</dt>
			<dd class="col-sm-9"><%= klasa.id %></dd>
			<dt class="col-sm-3">nazwa:</dt>
			<dd class="col-sm-9"><%= klasa.nazwa %></dd>
			<dt class="col-sm-3">profil klasy:</dt>
			<dd class="col-sm-9"><%= klasa.nazwa_profilu_klasy %></dd>
			<dt class="col-sm-3">Wychowawca:</dt>
			<dd class="col-sm-9"><%= klasa.imie %> <%= klasa.nazwisko %></dd>
		</dl>
		<div class="mt-3">
			<button type="button" class="btn btn-secondary" onclick="window.history.back()">Powrót</button>
			<button class="btn btn-danger" onclick="usun('/klasy/delete/<%= klasa.id %>')">Usuń</button>
			<a class="btn btn-primary" href="/klasy/update/<%= klasa.id %>">Edytuj</a>
		</div>
	</div>
</div>
