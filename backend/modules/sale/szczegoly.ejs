<div class="row">
	<div class="col-12">
		<h1>Szczegóły sali: <%= sala.nazwa %></h1>
	</div>
</div>
<div class="row">
	<div class="col-12">
		<dl class="row">
			<dt class="col-sm-3">id:</dt>
			<dd class="col-sm-9"><%= sala.id %></dd>
			<dt class="col-sm-3">nazwa:</dt>
			<dd class="col-sm-9"><%= sala.nazwa %></dd>
			<dt class="col-sm-3">ilość miejsc:</dt>
			<dd class="col-sm-9"><%= sala.ilosc_miejsc %></dd>
			<dt class="col-sm-3">typ sali:</dt>
			<dd class="col-sm-9"><%= sala.typ_sali %></dd>
			<dt class="col-sm-3">opiekun:</dt>
			<dd class="col-sm-9"><%= sala.imie %> <%= sala.nazwisko %></dd>
			<dt class="col-sm-3">Typy tablic:</dt>
			<dd class="col-sm-9">
				<ul class="list-unstyled">
					<% sala.typy_tablic.forEach(typ => { %>
						<li><%= typ.nazwa %></li>
					<% }) %>
				</ul>
			</dd>
		</dl>
		<div class="mt-3">
			<button type="button" class="btn btn-secondary" onclick="window.history.back()">Powrót</button>
			<button class="btn btn-danger" onclick="usun('/sale/delete/<%= sala.id %>')">Usuń</button>
			<a class="btn btn-primary" href="/sale/update/<%= sala.id %>">Edytuj</a>
		</div>
	</div>
</div>
