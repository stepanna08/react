<div class="row">
	<div class="col-12">
		<h1>Lista sal</h1>
	</div>
</div>
<div class="row">
	<div class="col-12">
		<ul class="list-group">
			<% sale.forEach(sala => { %>
				<li class="list-group-item">
					<a href="/sale/details/<%= sala.id %>">
						<%= sala.nazwa %>
					</a>
				</li>
			<% }) %>
		</ul>
		<p class="mt-3"><a class="btn btn-primary" href="/sale/add">Dodaj salę</a></p>
	</div>
</div>
