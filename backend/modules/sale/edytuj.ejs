<div class="row">
	<div class="col-12">
		<h1>Edytuj salę</h1>
	</div>
</div>
<form method="post" action="/sale/update">
	<input type="hidden" name="id" value="<%= sala.id %>" />
	<div class="row">
		<div class="col-12 col-md-4 mb-3">
			<label for="id_typu_sali" class="form-label">typ sali</label>
			<%- typy_sal %>
		</div>
		<div class="col-12 col-md-4 mb-3">
			<label for="id_typu_tablicy" class="form-label">typy tablic</label>
			<%- typy_tablic %>
		</div>
		<div class="col-12 col-md-4 mb-3">
			<label for="id_opiekuna" class="form-label">opiekun</label>
			<%- nauczyciele %>
		</div>
	</div>
	<div class="row">
		<div class="col-12 col-md-4 mb-3">
			<label for="nazwa" class="form-label">nazwa</label>
			<input type="text" name="nazwa" id="nazwa" value="<%= sala.nazwa %>" class="form-control" />
		</div>
		<div class="col-12 col-md-4 mb-3">
			<label for="ilosc_miejsc" class="form-label">ilość miejsc</label>
			<input type="number" name="ilosc_miejsc" id="ilosc_miejsc" value="<%= sala.ilosc_miejsc %>" class="form-control" />
		</div>
	</div>
	<div class="mt-3">
		<button type="button" class="btn btn-secondary" onclick="window.history.back()">Anuluj</button>
		<button type="submit" class="btn btn-primary">Zapisz</button>
	</div>
</form>
