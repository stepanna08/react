<div class="row">
	<div class="col-12">
		<h1>Edytuj szkołę: <%= szkola.nazwa %></h1>
	</div>
</div>
<form method="post" action="/szkoly/update">
	<div class="row">
		<div class="col-12 col-md-4 mb-3">
			<label for="nazwa" class="form-label">nazwa</label>
			<input type="text" name="nazwa" id="nazwa" value="<%= szkola.nazwa %>" class="form-control" />
		</div>
		<div class="col-12 col-md-4 mb-3">
			<label for="adres" class="form-label">adres</label>
			<input type="text" name="adres" id="adres" value="<%= szkola.adres %>" class="form-control" />
		</div>
		<div class="col-12 col-md-4 mb-3">
			<label for="telefon" class="form-label">telefon</label>
			<input type="text" name="telefon" id="telefon" value="<%= szkola.telefon %>" class="form-control" />
		</div>
	</div>
	<div class="row">
		<div class="col-12 col-md-4 mb-3">
			<label for="email" class="form-label">email</label>
			<input type="text" name="email" id="email" value="<%= szkola.email %>" class="form-control" />
		</div>
		<div class="col-12 col-md-4 mb-3">
			<label for="www" class="form-label">www</label>
			<input type="text" name="www" id="www" value="<%= szkola.www %>" class="form-control" />
		</div>
		<div class="col-12 col-md-4 mb-3">
			<label for="id_dyrektora" class="form-label">Dyrektor</label>
			<%- nauczyciele %>
		</div>
	</div>
	<div class="mt-3">
		<button type="button" class="btn btn-secondary" onclick="window.history.back()">Anuluj</button>
		<button type="submit" class="btn btn-primary">Zapisz</button>
	</div>
</form>
