<div class="row">
	<div class="col-12">
		<h1>Lista przedmiotów</h1>
	</div>
</div>
<div class="row">
	<div class="col-12">
		<ul class="list-group">
			<% przedmioty.forEach(przedmiot => { %>
				<li class="list-group-item">
					<a href="/przedmioty/details/<%= przedmiot.id %>">
						<%= przedmiot.nazwa %>
					</a>
				</li>
			<% }) %>
		</ul>
		<p class="mt-3"><a class="btn btn-primary" href="/przedmioty/add">Dodaj przedmiot</a></p>
	</div>
</div>
