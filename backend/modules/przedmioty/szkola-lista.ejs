<% if (dodajPrzedmiot) { %>
	<div class="alert alert-success" role="alert"><%= dodajPrzedmiot %></div>
<% } %>
<div class="row">
	<div class="col-12">
		<h1>Lista przedmiotów</h1>
	</div>
</div>
<div class="row">
	<div class="col-12">
		<% if (przedmioty.length) { %>
			<ul class="list-group">
				<% przedmioty.forEach(przedmiot => { %>
					<li class="list-group-item d-flex justify-content-between align-items-center">
						<span><%= przedmiot.nazwa %></span>
						<i class="fas fa-trash text-danger" style="cursor: pointer;" onclick="if(confirm('Czy na pewno usunąć przedmiot ze szkoły?')) { window.location='/przedmioty/szkola/delete/<%= przedmiot.id %>'; }"></i>
					</li>
				<% }) %>
			</ul>
		<% } else { %>
			<p>brak przedmiotów</p>
		<% } %>
		<p class="mt-3"><a class="btn btn-primary" href="/przedmioty/szkola/add">Dodaj przedmiot</a></p>
	</div>
</div>
