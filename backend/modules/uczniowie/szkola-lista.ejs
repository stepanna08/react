<% if (dodajUcznia) { %>
	<div class="alert alert-success" role="alert"><%= dodajUcznia %></div>
<% } %>
<div class="row">
	<div class="col-12">
		<h1>Lista uczniów</h1>
	</div>
</div>
<div class="row">
	<div class="col-12">
		<% if (uczniowie.length) { %>
			<ul class="list-group">
				<% uczniowie.forEach(uczen => { %>
					<li class="list-group-item d-flex justify-content-between align-items-center">
						<a href="/uczniowie/szkola/details/<%= uczen.id %>"><%= uczen.imie %> <%= uczen.nazwisko %></a>
						<i class="fas fa-trash text-danger" style="cursor: pointer;" onclick="if(confirm('Czy na pewno usunąć ucznia ze szkoły?')) { window.location='/uczniowie/szkola/delete/<%= uczen.id %>'; }"></i>
					</li>
				<% }) %>
			</ul>
		<% } else { %>
			<p>brak uczniów</p>
		<% } %>
		<p class="mt-3"><a class="btn btn-primary" href="/uczniowie/szkola/add">Dodaj ucznia</a></p>
	</div>
</div>
