<div class="row">
	<div class="col-12">
		<h1>Szczegóły ucznia</h1>
	</div>
</div>
<div class="row">
	<div class="col-12">
		<dl class="row">
			<dt class="col-sm-3">id:</dt>
			<dd class="col-sm-9"><%= uczen.id %></dd>
			<dt class="col-sm-3">imię:</dt>
			<dd class="col-sm-9"><%= uczen.imie %></dd>
			<dt class="col-sm-3">nazwisko:</dt>
			<dd class="col-sm-9"><%= uczen.nazwisko %></dd>
			<dt class="col-sm-3">telefon:</dt>
			<dd class="col-sm-9"><%= uczen.telefon %></dd>
			<dt class="col-sm-3">email:</dt>
			<dd class="col-sm-9"><%= uczen.email %></dd>
		</dl>
		<div class="mt-3">
			<a class="btn btn-secondary" href="/uczniowie/szkola/list">Powrót do listy</a>
			<a class="btn btn-primary" href="/uczniowie/update/<%= uczen.id %>">Edytuj</a>
		</div>
	</div>
</div>

<% if (typeof oceny !== 'undefined' && oceny.length > 0) { %>
<div class="row mt-4">
	<div class="col-12">
		<h2>Oceny ucznia</h2>
	</div>
</div>
<div class="row">
	<div class="col-12">
		<ul class="list-group">
			<% oceny.forEach(ocena => { %>
				<li class="list-group-item d-flex justify-content-between align-items-center">
					<a href="/oceny/details/<%= ocena.id %>">
						<%= ocena.nazwa_przedmiotu %>: <strong><%= ocena.wartosc %></strong> (<%= ocena.data %>) - <%= ocena.imie_nauczyciela %> <%= ocena.nazwisko_nauczyciela %>
						<% if (ocena.opis) { %> - <%= ocena.opis %><% } %>
					</a>
					<a href="/oceny/delete/<%= ocena.id %>" class="btn btn-danger btn-sm"><i class="fas fa-trash"></i></a>
				</li>
			<% }) %>
		</ul>
		<p class="mt-3"><a class="btn btn-primary" href="/oceny/add">Dodaj ocenę</a></p>
	</div>
</div>
<% } else { %>
<div class="row mt-4">
	<div class="col-12">
		<h2>Oceny ucznia</h2>
		<p>Brak ocen</p>
		<p class="mt-3"><a class="btn btn-primary" href="/oceny/add">Dodaj ocenę</a></p>
	</div>
</div>
<% } %>
