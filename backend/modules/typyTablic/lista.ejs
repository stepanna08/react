<div class="row">
	<div class="col-12">
		<h1>Lista typów tablic</h1>
	</div>
</div>
<div class="row">
	<div class="col-12">
		<% if (typyTablic.length) { %>
			<ul class="list-group">
				<% typyTablic.forEach(typ => { %>
					<li class="list-group-item">
						<a href="/typy-tablic/details/<%= typ.id %>">
							<%= typ.nazwa %>
						</a>
					</li>
				<% }) %>
			</ul>
		<% } else { %>
			<p>brak typów tablic</p>
		<% } %>
		<p class="mt-3"><a class="btn btn-primary" href="/typy-tablic/add">Dodaj typ tablicy</a></p>
	</div>
</div>
