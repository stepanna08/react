<div class="row">
	<div class="col-12">
		<h1>Lista typów sal</h1>
	</div>
</div>
<div class="row">
	<div class="col-12">
		<% if (typySal.length) { %>
			<ul class="list-group">
				<% typySal.forEach(typ => { %>
					<li class="list-group-item">
						<a href="/typy-sal/details/<%= typ.id %>">
							<%= typ.nazwa %>
						</a>
					</li>
				<% }) %>
			</ul>
		<% } else { %>
			<p>brak typów sal</p>
		<% } %>
		<p class="mt-3"><a class="btn btn-primary" href="/typy-sal/add">Dodaj typ sali</a></p>
	</div>
</div>
