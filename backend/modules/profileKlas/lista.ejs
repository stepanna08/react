<div class="row">
	<div class="col-12">
		<h1>Lista profili klas</h1>
	</div>
</div>
<div class="row">
	<div class="col-12">
		<% if (profileKlas.length) { %>
			<ul class="list-group">
				<% profileKlas.forEach(profil => { %>
					<li class="list-group-item">
						<a href="/profile-klas/details/<%= profil.id %>">
							<%= profil.nazwa %>
						</a>
					</li>
				<% }) %>
			</ul>
		<% } else { %>
			<p>brak profili klas</p>
		<% } %>
		<p class="mt-3"><a class="btn btn-primary" href="/profile-klas/add">Dodaj profil klasy</a></p>
	</div>
</div>
